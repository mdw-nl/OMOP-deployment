# Copy to .env before first `make up`:  make init
# .env is gitignored; this template is committed.

# --- Postgres ---------------------------------------------------------------
POSTGRES_DB=omop
POSTGRES_USER=omop
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# --- Schema layout ----------------------------------------------------------
# CDM_SCHEMA replaces the @cdmDatabaseSchema placeholder in the OHDSI scripts.
# Changing it after the first boot requires `make reset`.
CDM_SCHEMA=cdm
RESULTS_SCHEMA=results
TEMP_SCHEMA=temp

# --- Vocabulary -------------------------------------------------------------
# On `make up` the omop-init container loads the vocabulary into an empty CDM: the
# Athena CSVs in ./vocabulary if present, otherwise the zip at VOCAB_URL if set
# (downloaded once, kept in the omop_vocab_cache volume). Athena vocabularies are
# licensed, so only point this at a package you are allowed to use.
VOCAB_URL=
#VOCAB_URL=https://surfdrive.surf.nl/s/syJN2z2XaR5eMmM/download

# --- Data quality checks (OHDSI DQD) ------------------------------------------
# Password of the dqd role, which reads the CDM and writes the dqd_results schema.
DQD_PASSWORD=change_me
# Cron expression, UTC. Default: every night at 02:00.
DQD_SCHEDULE=0 2 * * *
# Also run the checks every time the container starts.
DQD_RUN_ON_START=true
DQD_THREADS=2

# --- pgAdmin ----------------------------------------------------------------
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=change_me
PGADMIN_PORT=8080

# --- Postgres tuning --------------------------------------------------------
# Raised from Postgres defaults for the vocabulary bulk load. Lower these if
# your Docker VM has little memory; shared_buffers should stay under ~25% of it.
PG_SHARED_BUFFERS=512MB
PG_MAINTENANCE_WORK_MEM=512MB
PG_WORK_MEM=64MB
PG_MAX_WAL_SIZE=4GB
