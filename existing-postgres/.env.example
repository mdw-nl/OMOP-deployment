# Copy to .env before running anything:  make init
#
# This folder deploys OMOP CDM 5.4 into a Postgres you ALREADY run. It never starts,
# stops, or recreates a container, and it never touches a data volume.

# ---------------------------------------------------------------------------
# 1. How should psql reach your database?
# ---------------------------------------------------------------------------
# host   = use a psql client on this machine over TCP (needs psql installed;
#          `brew install libpq` if you don't have it). No change to your compose.
# docker = run psql inside your existing Postgres container via `docker exec`.
#          No psql needed on the host.
#
# This choice also decides how the vocabulary CSVs are read — see section 5.
PSQL_MODE=host

# Only used when PSQL_MODE=docker. Find it with: docker compose ps
DOCKER_CONTAINER=postgres

# ---------------------------------------------------------------------------
# 2. Connection (standard libpq variables — psql reads these directly)
# ---------------------------------------------------------------------------
# In docker mode PGHOST/PGPORT are ignored; psql uses the container's local socket.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change_me

# ---------------------------------------------------------------------------
# 3. Where should OMOP live?
# ---------------------------------------------------------------------------
# Recommended: a dedicated database inside your existing instance. Fully isolated
# from your other data, and `make drop-db` gives you a clean slate.
TARGET_DB=omop

# true  -> `make create-db` creates TARGET_DB if missing (recommended)
# false -> TARGET_DB is an existing database; OMOP goes in as extra schemas.
#          Set SET_DB_SEARCH_PATH=false in that case (see below).
CREATE_DB=true

# ---------------------------------------------------------------------------
# 4. Schema layout inside TARGET_DB
# ---------------------------------------------------------------------------
# CDM_SCHEMA replaces the @cdmDatabaseSchema placeholder in the OHDSI scripts.
CDM_SCHEMA=cdm
RESULTS_SCHEMA=results
TEMP_SCHEMA=temp

# Sets `ALTER DATABASE <TARGET_DB> SET search_path` so unqualified table names
# resolve to the CDM schema.
#
# KEEP true for a dedicated OMOP database.
# SET false if you are adding schemas to a database that other applications use —
# it would change name resolution for every one of their connections.
SET_DB_SEARCH_PATH=true

# ---------------------------------------------------------------------------
# 5. Vocabulary CSVs (Athena download — see vocabulary/README.md)
# ---------------------------------------------------------------------------
# `\copy` reads files relative to wherever the psql CLIENT runs, so:
#
#   PSQL_MODE=host   -> VOCAB_DIR is a path on THIS machine. Works with no changes
#                       to your compose file. CSVs stream over the connection.
#
#   PSQL_MODE=docker -> VOCAB_DIR is a path INSIDE the container. You must add a
#                       read-only mount to your Postgres service first, e.g.
#                         - /abs/path/to/vocabulary:/vocabulary:ro
#                       then VOCAB_DIR=/vocabulary. Faster for large downloads,
#                       but requires recreating the container.
VOCAB_DIR=./vocabulary

# Optional: `make download-vocab` downloads this zip and extracts the CSVs into
# VOCAB_DIR (host mode). Athena vocabularies are licensed, so only point this at a
# package you are allowed to use.
VOCAB_URL=

# ---------------------------------------------------------------------------
# 6. Data quality checks and dashboard (make quality-up, optional)
# ---------------------------------------------------------------------------
# Runs DQD (and Superset) in containers of their own, compose project omop-apps,
# against TARGET_DB at OMOP_DB_HOST. host.docker.internal is the Docker host, which
# works when your Postgres port is published there. PGUSER creates the roles below:
# a superuser, or CREATEROLE + CREATEDB with membership in those roles (Postgres 16+).
OMOP_DB_HOST=host.docker.internal
# Port the containers use; defaults to PGPORT.
#OMOP_DB_PORT=5432

# Role `dqd`: reads the CDM, owns the dqd_results schema.
DQD_PASSWORD=change_me
# Cron expression, UTC. Default: every night at 02:00. Keep the quotes: the
# scripts source this file with bash.
DQD_SCHEDULE="0 2 * * *"
DQD_RUN_ON_START=true
DQD_THREADS=2

# Every Superset user can read the CDM, see the README warning.
SUPERSET_PORT=8088
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=change_me
# Owner of the `superset` metadata database on your Postgres server.
SUPERSET_DB_PASSWORD=change_me
# Read-only role the dashboards query the CDM and dqd_results with.
SUPERSET_READER_PASSWORD=change_me
# Optional. Left empty, a key is generated on first start and kept in a volume.
SUPERSET_SECRET_KEY=
